PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# LLM: use ONE of the options below
# Option A: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Option B: any OpenAI-compatible provider, e.g. Google Gemini free tier (key from aistudio.google.com)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash
# Option C: Anthropic (default model claude-sonnet-4-6)
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai   # optional override: openai | anthropic

DATABASE_URL="file:./dev.db"
